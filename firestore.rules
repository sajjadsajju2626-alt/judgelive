rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEventCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 32 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation Blueprint: CampusRegistry (/campus_registry/{festivalCode})
    function isValidCampusRegistry(data, festivalCode) {
      return data.keys().hasAll(['festivalCode', 'title', 'adminPin', 'isActive', 'expiresAt']) &&
        data.keys().hasOnly([
          'festivalCode', 'title', 'subtitle', 'adminPin',
          'chartType', 'gradeA', 'gradeB', 'gradeC',
          'isActive', 'expiresAt', 'createdAt', 'updatedAt'
        ]) &&
        data.festivalCode is string &&
        data.festivalCode.size() >= 2 &&
        data.festivalCode.size() <= 32 &&
        data.festivalCode == festivalCode &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 120 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 160)) &&
        data.adminPin is string &&
        data.adminPin.size() >= 4 &&
        data.adminPin.size() <= 16 &&
        data.adminPin.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.isActive is bool &&
        data.expiresAt is string &&
        data.expiresAt.size() == 10 &&
        data.expiresAt.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        (!('chartType' in data) || (
          data.chartType is string &&
          data.chartType.size() <= 24 &&
          data.chartType in ['bar', 'horizontal', 'doughnut']
        )) &&
        (!('gradeA' in data) || (data.gradeA is number && data.gradeA >= 1 && data.gradeA <= 100)) &&
        (!('gradeB' in data) || (data.gradeB is number && data.gradeB >= 1 && data.gradeB <= 100)) &&
        (!('gradeC' in data) || (data.gradeC is number && data.gradeC >= 0 && data.gradeC <= 100)) &&
        (!('gradeA' in data && 'gradeB' in data) || data.gradeA > data.gradeB) &&
        (!('gradeB' in data && 'gradeC' in data) || data.gradeB > data.gradeC) &&
        (!('gradeA' in data && 'gradeC' in data) || data.gradeA > data.gradeC) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Cross-Device Campus Registry Collection
    match /campus_registry/{festivalCode} {
      allow get: if isValidEventCode(festivalCode);
      allow list: if request.time != null;
      allow create, update: if isValidEventCode(festivalCode) && isValidCampusRegistry(incoming(), festivalCode);
      allow delete: if isValidEventCode(festivalCode);
    }

    // Multi-Event Workspace Scope (Cross-Device Judging, Tabulation, Admin & Demo Sync)
    match /events/{festivalCode}/{document=**} {
      allow read, write: if isValidEventCode(festivalCode);
    }

    // Connection health probe document
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }
  }
}
