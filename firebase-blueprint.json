{
  "entities": {
    "CampusRegistry": {
      "title": "CampusRegistry",
      "description": "Top-level cross-device registry record for each registered campus/festival workspace stored at campus_registry/{festivalCode}.",
      "type": "object",
      "properties": {
        "festivalCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$",
          "description": "Normalized uppercase festival/campus code."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Institution or festival display title."
        },
        "subtitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Subtitle or venue description."
        },
        "adminPin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Per-event Admin PIN assigned to unlock the campus Admin Panel."
        },
        "chartType": {
          "type": "string",
          "enum": ["bar", "horizontal", "doughnut"],
          "maxLength": 24,
          "description": "Selected visualization chart type for Group Points & Standings."
        },
        "gradeA": {
          "type": "number",
          "description": "Minimum percentage threshold for Grade A."
        },
        "gradeB": {
          "type": "number",
          "description": "Minimum percentage threshold for Grade B."
        },
        "gradeC": {
          "type": "number",
          "description": "Minimum percentage threshold for Grade C."
        },
        "isActive": {
          "type": "boolean",
          "description": "Commercial license activation status (true = active, false = suspended)."
        },
        "expiresAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Inclusive event license expiry date in YYYY-MM-DD format."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the event was registered."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest registry update."
        }
      },
      "required": ["festivalCode", "title", "adminPin", "isActive", "expiresAt"]
    },
    "EventConfig": {
      "title": "EventConfig",
      "description": "Isolated campus or festival configuration including display title, subtitle, and custom event admin PIN stored at events/{festivalCode}/settings/config.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^config$",
          "description": "Fixed document identifier ('config')."
        },
        "eventCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9_\\-]+$",
          "description": "Normalized uppercase event/campus code."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Institution or festival display title."
        },
        "subtitle": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Subtitle or venue description."
        },
        "adminPin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Custom event-specific Admin PIN for unlocking the campus Admin Panel."
        },
        "chartType": {
          "type": "string",
          "enum": ["bar", "horizontal", "doughnut"],
          "maxLength": 24,
          "description": "Admin-selected visualization chart type for Group Points & Standings."
        },
        "gradeA": {
          "type": "number",
          "description": "Minimum percentage threshold for Grade A (default 80, must be > gradeB and <= 100)."
        },
        "gradeB": {
          "type": "number",
          "description": "Minimum percentage threshold for Grade B (default 70, must be > gradeC and < gradeA)."
        },
        "gradeC": {
          "type": "number",
          "description": "Minimum percentage threshold for Grade C (default 60, must be >= 0 and < gradeB)."
        },
        "isActive": {
          "type": "boolean",
          "description": "Commercial license activation status (true = active, false = suspended)."
        },
        "expiresAt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Inclusive event license expiry date in YYYY-MM-DD format."
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional device or creator identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the event was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest config update."
        }
      },
      "required": ["id", "eventCode", "title", "subtitle", "adminPin", "createdAt", "updatedAt"]
    },
    "Group": {
      "title": "Group",
      "description": "A house, team, or group registered within a specific festivalCode for team standings calculation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier for the group/house."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the group or house (e.g., Red House)."
        },
        "color": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Hex color code used for badges and standings charts."
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional device or creator identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the group was created."
        }
      },
      "required": ["id", "name", "color", "createdAt"]
    },
    "CompetitionItem": {
      "title": "CompetitionItem",
      "description": "An arts festival competition event or item scoped to a specific festivalCode.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique identifier for the competition item."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "English name of the competition item."
        },
        "malayalamName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Malayalam name of the competition item."
        },
        "category": {
          "type": "string",
          "enum": ["High School", "Higher Secondary", "General", "Sub-Junior"],
          "maxLength": 40,
          "description": "Competition division category."
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Assigned stage or venue name."
        },
        "maxMarks": {
          "type": "number",
          "description": "Maximum marks possible for this item (always 100)."
        },
        "criteria": {
          "type": "array",
          "description": "4 item-specific judging criterion labels (25 marks each)."
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional device or creator identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the item was created."
        }
      },
      "required": ["id", "name", "malayalamName", "category", "stage", "maxMarks", "createdAt"]
    },
    "Participant": {
      "title": "Participant",
      "description": "A registered contestant with a chest number assigned to a competition item within a festivalCode.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique participant document identifier."
        },
        "itemId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced competition item ID."
        },
        "chestNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z0-9\\-]+$",
          "description": "Contestant chest number."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full name of the contestant or team lead."
        },
        "school": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "School, college, or house represented."
        },
        "groupId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^([a-zA-Z0-9_\\-]+)?$",
          "description": "Optional linked Group document ID."
        },
        "groupName": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional linked Group display name."
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional device or creator identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when registered."
        }
      },
      "required": ["id", "itemId", "chestNo", "name", "school", "createdAt"]
    },
    "JudgeScore": {
      "title": "JudgeScore",
      "description": "Score entry submitted by a judge for a specific participant in a festivalCode.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic score ID combining itemId, participantId, and judgeSlot."
        },
        "itemId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Competition item ID."
        },
        "participantId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Participant document ID."
        },
        "chestNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "description": "Participant chest number."
        },
        "judgeSlot": {
          "type": "string",
          "enum": ["J1", "J2", "J3"],
          "maxLength": 10,
          "description": "Judge panel slot identifier."
        },
        "judgeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the judge."
        },
        "rhythm": {
          "type": "number",
          "description": "Criterion 1 score (0-25)."
        },
        "expression": {
          "type": "number",
          "description": "Criterion 2 score (0-25)."
        },
        "perfection": {
          "type": "number",
          "description": "Criterion 3 score (0-25)."
        },
        "overall": {
          "type": "number",
          "description": "Criterion 4 score (0-25)."
        },
        "total": {
          "type": "number",
          "description": "Total score out of 100."
        },
        "remarks": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional judge evaluation notes."
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional device or judge identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest score update."
        }
      },
      "required": [
        "id",
        "itemId",
        "participantId",
        "chestNo",
        "judgeSlot",
        "judgeName",
        "rhythm",
        "expression",
        "perfection",
        "overall",
        "total",
        "remarks",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/campus_registry/{festivalCode}": {
      "schema": { "$ref": "#/entities/CampusRegistry" },
      "description": "Top-level real-time synchronized directory of registered campus/festival workspaces, PINs, and license metadata."
    },
    "/events/{festivalCode}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/EventConfig" },
      "description": "Stores isolated institution config (title, subtitle, adminPin, chartType, grading rules, license) for a specific festivalCode."
    },
    "/events/{festivalCode}/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Stores registered houses/teams/groups isolated to festivalCode."
    },
    "/events/{festivalCode}/items/{itemId}": {
      "schema": { "$ref": "#/entities/CompetitionItem" },
      "description": "Stores competition events and items isolated to festivalCode."
    },
    "/events/{festivalCode}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Stores registered participants and chest numbers isolated to festivalCode."
    },
    "/events/{festivalCode}/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/JudgeScore" },
      "description": "Stores real-time judge score submissions isolated to festivalCode."
    }
  }
}
